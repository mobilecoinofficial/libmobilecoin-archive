source 'https://rubygems.org' do
  # SwiftProtobuf's podspec declares cocoapods_version >= 1.13.0, so every
  # subspec that depends on it needs a CocoaPods at least that new to lint.
  gem 'cocoapods', '~> 1.16'
  gem 'cocoapods-deintegrate', '~> 1.0', '>= 1.0.4'
  gem 'rexml'
  gem 'pkg-config'
end
