# The single source of truth for the release. Package.swift, LibMobileCoin.podspec
# and the Makefile all read this file, so a release changes one place.
#
# VERSION is the pod version and, with a "v" prefix, the git tag.
# XCFRAMEWORK_SHA256 is the SwiftPM checksum of the release asset for VERSION.
# The release workflow writes both, because the checksum is only known after the
# xcframework is built.
VERSION=6.0.4
XCFRAMEWORK_SHA256=11add94b73891b3203d627590fe3a1c3c53c561cf9f8817cbb7c378f78736527
